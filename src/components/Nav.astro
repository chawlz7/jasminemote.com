---
import { NAV } from '../consts';

const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(href);
const wwm = current('/work-with-me/');
---

<nav aria-label="Main">
	<div class="container bar">
		<a class="wordmark serif" href="/">Jasmine Mote, <em>PhD</em></a>
		<ul class="links">
			{NAV.map(({ label, href }) => (
				<li><a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a></li>
			))}
			<li>
				<a class:list={['btn', wwm ? 'btn-primary' : 'btn-secondary', 'cta']} href="/work-with-me/" aria-current={wwm ? 'page' : undefined}>Work with me</a>
			</li>
		</ul>
	</div>
</nav>

<style>
	nav { border-bottom: 1px solid var(--rule); background: var(--surface-page); }
	.bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3) var(--space-5); padding-block: 18px; }
	.wordmark { font-size: 1.4375rem; color: var(--text-primary); text-decoration: none; }
	.links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); list-style: none; padding: 0; font-size: 1rem; }
	.links a:not(.btn) { color: var(--text-primary); text-decoration: none; }
	.links a:not(.btn):hover { color: var(--action); }
	.links a[aria-current='page']:not(.btn) { color: var(--action); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; }
	.cta { min-height: 44px; padding: 0 20px; }
	@media (max-width: 640px) {
		.links { gap: var(--space-2) var(--space-5); font-size: 0.9375rem; }
	}
</style>
