---
import Medallion from './Medallion.astro';
import { NAV } from '../consts';
---

<footer>
	<img class="sprig" src="/images/sprig-sunlit.png" alt="" width="561" height="363" loading="lazy" />
	<div class="container row">
		<a class="sign" href="/">
			<Medallion size={64} field="var(--violet-600)" line="var(--linen-50)" />
			<span class="serif name">Jasmine Mote, <span class="phd">PhD</span></span>
		</a>
		<ul class="links">
			{NAV.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
			<li><a href="/work-with-me/">Work With Me</a></li>
		</ul>
		<span class="place">Somerville, MA</span>
	</div>
</footer>

<style>
	footer { position: relative; overflow: hidden; background: var(--surface-inverse); color: var(--linen-50); }
	/* One sprig of her vine grows up from the bottom-right edge (design system: botanicals). */
	.sprig { position: absolute; right: 3%; bottom: -6px; width: clamp(140px, 18vw, 250px); }
	.row { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-5); padding-block: var(--space-8); padding-right: clamp(var(--gutter), 15vw, 220px); }
	.sign { display: flex; align-items: center; gap: var(--space-4); color: inherit; text-decoration: none; }
	.name { font-size: 1.4375rem; }
	.phd { color: var(--lavender-on-ink); }
	.links { display: flex; flex-wrap: wrap; gap: var(--space-5); list-style: none; padding: 0; font-size: var(--type-small); }
	.links a { color: var(--linen-50); text-decoration: none; }
	.links a:hover { color: var(--lavender-on-ink); text-decoration: underline; }
	.place { font-size: var(--type-meta); color: var(--muted-on-ink); }
	@media (max-width: 640px) { .row { padding-bottom: 150px; } }
</style>
