---
// Her line caricature, one line color on one circular field (design system: the caricature in a
// supporting role). The drawing is used as a mask so its color comes from tokens.
interface Props {
	size: number;
	field?: string;
	line?: string;
}
const { size, field = 'var(--periwinkle-400)', line = 'var(--ink-900)' } = Astro.props;
---

<span class="medallion" style={`--size: ${size}px; --field: ${field}; --line: ${line}`} aria-hidden="true"><span></span></span>

<style>
	.medallion { width: var(--size); height: var(--size); flex: none; border-radius: 50%; background: var(--field); display: inline-flex; align-items: flex-end; justify-content: center; overflow: hidden; }
	.medallion span {
		width: 83%; height: 95%; background: var(--line);
		-webkit-mask: url(/images/jasmine-line-portrait.png) center / contain no-repeat;
		mask: url(/images/jasmine-line-portrait.png) center / contain no-repeat;
	}
</style>
