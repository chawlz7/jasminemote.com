---
// Every page: <head> (title, description, sharing tags, structured data, fonts), nav, main, footer.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_DESCRIPTION, LINKS, SITE_NAME, SITE_URL } from '../consts';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}
const { title, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Jasmine Mote',
	honorificSuffix: 'PhD',
	url: SITE_URL,
	image: new URL('/jasmine-headshot.webp', SITE_URL).href,
	description:
		'Licensed clinical psychologist in the Boston area, Research Assistant Professor at Boston University, and science writer. Specializes in anxiety, OCD, perinatal mental health, emotion, and social connection.',
	jobTitle: ['Clinical Psychologist', 'Research Assistant Professor'],
	worksFor: [
		{ '@type': 'CollegeOrUniversity', name: 'Boston University', url: 'https://www.bu.edu' },
		{ '@type': 'MedicalOrganization', name: 'Cambridge Psychology Group', url: 'https://cambridgepsych.org' },
	],
	address: { '@type': 'PostalAddress', addressLocality: 'Somerville', addressRegion: 'MA', addressCountry: 'US' },
	knowsAbout: ['Clinical Psychology', 'Emotion Regulation', 'Social Connection', 'Schizophrenia', 'Perinatal Mental Health', 'OCD', 'Anxiety', 'Ecological Momentary Assessment'],
	sameAs: [LINKS.scholar, LINKS.researchgate, LINKS.bluesky, LINKS.substack, LINKS.psychologyToday, LINKS.cpg],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#F5F0E8" />
		<!-- Arms the grow-in reveals before first paint, only where motion is welcome. -->
		<script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.documentElement.classList.add('motion');</script>

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Jasmine Mote, PhD — Clinical Psychologist, Researcher, Writer" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(person)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Hedvig+Letters+Serif:opsz@12..24&family=Albert+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
		/>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Nav />
		<main id="main"><slot /></main>
		<Footer />
		<script>
			// Grow each [data-grow] element (her vines, the research bars, the step line) once it is
			// a little way into view. An element inside a [data-grow-scope] (the footer) grows when the
			// scope's top edge arrives instead: the footer's sprig sits at the very bottom of the page,
			// where the page can't scroll it any further up. Without html.motion everything just shows.
			if (document.documentElement.classList.contains('motion')) {
				const grow: IntersectionObserverCallback = (entries, observer) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						const targets = e.target.matches('[data-grow]') ? [e.target] : e.target.querySelectorAll('[data-grow]');
						targets.forEach((t) => t.classList.add('grown'));
						observer.unobserve(e.target);
					}
				};
				// Elements grow once a little way into view; a scope grows the moment its top edge shows.
				const inView = new IntersectionObserver(grow, { rootMargin: '0px 0px -12% 0px' });
				const atEdge = new IntersectionObserver(grow);
				const scopes = new Set<Element>();
				document.querySelectorAll('[data-grow]').forEach((el) => {
					const scope = el.closest('[data-grow-scope]');
					if (scope) scopes.add(scope);
					else inView.observe(el);
				});
				scopes.forEach((scope) => atEdge.observe(scope));
			}
		</script>
	</body>
</html>

<style>
	.skip { position: absolute; left: 12px; top: -60px; z-index: 10; padding: 10px 16px; border-radius: var(--radius-sm); background: var(--ink-900); color: var(--linen-50); }
	.skip:focus { top: 12px; }
</style>
